PORT=8000
PUBLIC_BASE_URL=https://marketing.klubnavi.de
MCP_BEARER_TOKEN=replace-with-a-long-random-token
ADMIN_TOKEN=replace-with-another-long-random-token
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://marketing.klubnavi.de/oauth/google/callback
CHATGPT_OAUTH_CLIENT_ID=marketing-mcp-chatgpt
CHATGPT_OAUTH_CLIENT_SECRET=replace-with-a-long-random-client-secret
CHATGPT_OAUTH_REDIRECT_URI=https://chatgpt.com/connector/oauth/replace-with-your-callback-id
TOKEN_STORE_PATH=/app/data/google-connections.enc
