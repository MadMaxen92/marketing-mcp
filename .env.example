PORT=8000
PUBLIC_BASE_URL=https://marketing.klubnavi.de
MCP_BEARER_TOKEN=replace-with-a-long-random-token
ADMIN_TOKEN=replace-with-another-long-random-token
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
